<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wall-E - Full Screen"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black">

    <Grid x:Name="RootGrid">
        <Image x:Name="ImgFullScreen" Stretch="Uniform"/>

        <StackPanel x:Name="PnlVideoBadgeFS" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="88" Height="88" CornerRadius="44" Background="#1E1E24" BorderBrush="#D8A94A" BorderThickness="2">
                <TextBlock Text="▶" FontSize="34" Foreground="#D8A94A" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,0,0,0"/>
            </Border>
            <TextBlock Text="PLAYING AS VIDEO WALLPAPER" FontSize="14" FontWeight="Bold" Foreground="#D8A94A" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Text="Minimize or move this window to see it on the desktop" FontSize="11" Foreground="#8C8C94" HorizontalAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <TextBlock Text="Esc or click anywhere to exit full screen"
                    FontSize="12" Foreground="#8C8C94"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18"/>
    </Grid>
</Window>
