<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wall-E - Full Screen"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black">

    <Grid x:Name="RootGrid">
        <Image x:Name="ImgFullScreen" Stretch="Uniform"/>

        <!-- Live, muted, looping preview mirroring the real video
             wallpaper's Stretch mode - same rationale as MedPreview in
             the main window. -->
        <MediaElement x:Name="MedPreviewFS" Stretch="Uniform"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      IsMuted="True" Visibility="Collapsed"/>

        <Border x:Name="PnlVideoBadgeFS" Visibility="Collapsed"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="20"
                Background="#CC0F0F13" BorderBrush="#D8A94A" BorderThickness="1" CornerRadius="6" Padding="12,7">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="🔇" FontSize="13" Margin="0,0,7,0"/>
                <TextBlock Text="Preview muted - desktop wallpaper may have audio" FontSize="12" Foreground="#8C8C94"/>
            </StackPanel>
        </Border>

        <!-- Fallback only - shown if MedPreviewFS itself fails to open
             (MediaFailed), so full screen doesn't just go plain black with
             no explanation. The desktop wallpaper copy is a separate
             playback and is unaffected by this failure. -->
        <StackPanel x:Name="PnlVideoUnavailableFS" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="▶" FontSize="28" Foreground="#D8A94A" HorizontalAlignment="Center"/>
            <TextBlock Text="PLAYING AS VIDEO WALLPAPER" FontSize="12" FontWeight="Bold" Foreground="#D8A94A" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Check your desktop - couldn't load a full-screen preview for this file" FontSize="11" Foreground="#8C8C94" HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
        </StackPanel>

        <TextBlock Text="Esc or click anywhere to exit full screen"
                    FontSize="12" Foreground="#8C8C94"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18"/>
    </Grid>
</Window>
