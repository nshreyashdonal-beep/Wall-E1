<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wall-E - Full Screen"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="Black">

    <Grid x:Name="RootGrid">
        <Image x:Name="ImgFullScreen" Stretch="Uniform"/>

        <!-- Live, muted, looping preview - sized/stretched in code-behind
             (see Apply-FullScreenVideoAspectRatio in Wall-E.ps1) to match
             EXACTLY what Show-VideoWallpaper puts on the real desktop:
             same crop-to-fill on "Default", same forced-ratio letterbox
             math on a specific aspect ratio. Previously this was hardcoded
             to Stretch="Uniform" (always showing the untouched native
             frame) regardless of the selected aspect ratio, so it could
             visibly disagree with the actual wallpaper. -->
        <MediaElement x:Name="MedPreviewFS" Stretch="UniformToFill"
                      LoadedBehavior="Manual" UnloadedBehavior="Manual"
                      IsMuted="True" Visibility="Collapsed"/>

        <!-- Opaque black masks, drawn ON TOP of MedPreviewFS - same
             rationale as VideoWallpaper.ps1's BarTop/Bottom/Left/Right:
             a MediaElement's video surface can ignore its own WPF layout
             bounds, so these guarantee the letterbox/pillarbox bars show
             correctly regardless. Sized to 0 (invisible) unless a forced
             aspect ratio is active. -->
        <Rectangle x:Name="FsBarTop"    Fill="Black" Height="0" VerticalAlignment="Top"    HorizontalAlignment="Stretch"/>
        <Rectangle x:Name="FsBarBottom" Fill="Black" Height="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
        <Rectangle x:Name="FsBarLeft"   Fill="Black" Width="0"  HorizontalAlignment="Left"  VerticalAlignment="Stretch"/>
        <Rectangle x:Name="FsBarRight"  Fill="Black" Width="0"  HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

        <!-- Fallback only - shown if MedPreviewFS itself fails to open
             (MediaFailed), so full screen doesn't just go plain black with
             no explanation. The desktop wallpaper copy is a separate
             playback and is unaffected by this failure. -->
        <StackPanel x:Name="PnlVideoUnavailableFS" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="▶" FontSize="28" Foreground="#D8A94A" HorizontalAlignment="Center"/>
            <TextBlock Text="PLAYING AS VIDEO WALLPAPER" FontSize="12" FontWeight="Bold" Foreground="#D8A94A" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="Check your desktop - couldn't load a full-screen preview for this file" FontSize="11" Foreground="#8C8C94" HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"/>
        </StackPanel>

        <TextBlock Text="Esc or click anywhere to exit full screen"
                    FontSize="12" Foreground="#8C8C94"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,18"/>
    </Grid>
</Window>
