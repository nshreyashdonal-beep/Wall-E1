<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wall-E" Height="850" Width="440"
        MinHeight="540" MinWidth="380"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#0C0C10">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#16161B"/>
        <SolidColorBrush x:Key="BorderBrush2" Color="#2A2A30"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#D8A94A"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8E8E8"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#8C8C94"/>
        <SolidColorBrush x:Key="MarkerSelectedBrush" Color="#E5484D"/>

        <Style TargetType="Button" x:Key="NavButton">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button" x:Key="PrimaryButton" BasedOn="{StaticResource NavButton}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1400"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style TargetType="RadioButton" x:Key="SpeedOption">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="OptBorder" Background="#1E1E24" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OptBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#1A1400"/>
                                <Setter TargetName="OptBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin, gold-accented scrollbar matching the rest of the app's
             look - without this, the settings ScrollViewer used the default
             Windows gray scrollbar, which stood out against the app's dark/
             gold theme. Applies to every ScrollBar in this window (no
             x:Key), including the one the ScrollViewer generates for
             itself. -->
        <Style TargetType="Thumb" x:Key="ScrollThumbStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{StaticResource AccentBrush}" CornerRadius="4" Opacity="0.5"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RepeatButton" x:Key="ScrollRepeatTransparent">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Rectangle Fill="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollRepeatTransparent}" Command="ScrollBar.PageUpCommand"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollRepeatTransparent}" Command="ScrollBar.PageDownCommand"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumbStyle}" Width="6" Margin="1,0"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark-theme TextBox - previously only had colors set inline
             (on TxtRootPath), with no custom template, so it still used the
             default Windows chrome (bevel edges, default blue selection/
             caret) underneath. No x:Key - applies to every TextBox in this
             window automatically. Local Background/Foreground/BorderBrush
             values set directly on an individual TextBox (e.g. TxtRootPath)
             still flow through via TemplateBinding below, so this doesn't
             fight with those - it just adds the rounded dark chrome, amber
             hover/focus border, and amber caret/selection around them. -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="TxtBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <!-- PART_ContentHost is a required name WPF looks
                                 for in any custom TextBox template - without
                                 it, the text simply never renders. -->
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="TxtBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark-theme CheckBox - previously only had Foreground set (the
             label text), so the actual check square itself still rendered
             as the default plain white/grey Windows box. No x:Key -
             applies to every CheckBox in this window (ChkHotkeys,
             ChkVideoAudio, ChkShuffle) automatically. -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckBorder" Width="16" Height="16" CornerRadius="3"
                                    Background="#1E1E24" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="CheckMark" Data="M 3,8 L 7,12 L 13,4" Stroke="#1A1400" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem chrome for the dropdown list below - dark panel
             background, amber highlight on hover, amber fill + dark text
             on the selected item. No x:Key - applies to every
             ComboBoxItem generated inside any ComboBox's dropdown. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BorderBrush2}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="#1A1400"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark-theme ComboBox - previously had no Style at all, so
             CmbPreviewStretch, CmbStyle, CmbVideoAspect, and CmbInterval
             all rendered as the plain default Windows combo (white
             dropdown button, black-on-white popup list), the most visually
             jarring plain elements against this dark theme. No x:Key -
             applies to all four automatically. -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#1E1E24"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush2}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleBtn"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Focusable="False">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"/>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="10,6,28,6"
                                              VerticalAlignment="Center" HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                            <TextBlock Text="▾" Foreground="{StaticResource AccentBrush}" FontSize="10"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Margin="0,0,10,0" IsHitTestVisible="False"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Margin="16">
        <Grid.RowDefinitions>
            <!-- Row 0's Height starts at 3* (fills leftover space) but is
                 switched to an exact PIXEL height in code-behind
                 (Apply-PreviewVideoAspectRatio / Reset-PreviewHostSize)
                 whenever a video with a known aspect ratio is showing -
                 sized to header-height + the video box's own computed
                 height, so PreviewArea's "*" row below gets EXACTLY the
                 video box's height with nothing left over. Previously this
                 row always claimed all leftover vertical space regardless
                 of the (width-driven, and therefore often much shorter)
                 video box height, which centered a short video box inside
                 a much taller row - clean when the window was wide enough
                 for the box to fill the row, but leaving big blank gaps
                 above/below at the app's default tall/narrow startup size.
                 Reverts to 3* for images (which still want to fill all
                 available space, unaffected by this) and before a video's
                 native size is known.

                 The settings ScrollViewer below still needs a *finite*
                 height to fit into regardless of which mode Row 0 is in -
                 a ScrollViewer placed in an Auto row gets asked to measure
                 at infinite height, so it just grows to fit its content
                 and its scrollbar never engages. Row 1 stays star-sized
                 (now the only "*" row most of the time, so it claims
                 whatever Row 0 didn't use) with its own MinHeight floor,
                 so that finite-height guarantee holds either way. -->
            <RowDefinition x:Name="PreviewRowDef" Height="3*" MinHeight="260"/>
            <RowDefinition Height="2*" MinHeight="230"/>
        </Grid.RowDefinitions>

        <!-- Header + Preview: this row's height is managed in code-behind
             (see PreviewRowDef above) so the video box is never centered
             inside more vertical space than it actually needs. -->
        <Grid x:Name="HeaderGrid" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="W A L L - E" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                               Foreground="#39FF7A">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#39FF7A" BlurRadius="18" ShadowDepth="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Movie snapshots &amp; video clips as your desktop background" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Button x:Name="BtnHowTo" Grid.Column="1" Content="?  How to Use" Style="{StaticResource NavButton}"
                        VerticalAlignment="Top" Padding="12,6" FontSize="12" ToolTip="Getting started, shortcuts, and why it beats the built-in slideshow"/>
            </Grid>

            <Grid x:Name="PreviewArea" Grid.Row="1">
                <Border x:Name="PreviewHost" MinHeight="180" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8">
                    <Grid x:Name="PreviewHostGrid" ClipToBounds="True">
                        <Image x:Name="ImgPreview" Stretch="Uniform" Margin="6"/>

                        <!-- Live in-app preview of the current video, muted
                             (its audio, if any, only ever plays through the
                             real desktop-wallpaper copy - see
                             Show-VideoWallpaper). A second, independent
                             playback of the same file - it won't be
                             frame-synced with the desktop copy, but shows
                             the same content so you can preview framing/
                             aspect ratio without alt-tabbing to the desktop. -->
                        <MediaElement x:Name="VidPreview" Visibility="Collapsed" LoadedBehavior="Manual" UnloadedBehavior="Manual"
                                      IsMuted="True" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                        <!-- Opaque black bars, drawn ON TOP of VidPreview, that
                             mimic the letterbox/pillarbox bars the desktop
                             video wallpaper shows when a non-Default aspect
                             ratio is forced (see Set-VideoWallpaperAspectRatio
                             for why a real MediaElement can't be trusted to
                             clip/letterbox itself reliably). Sized to 0
                             (invisible) unless a forced ratio is selected. -->
                        <Rectangle x:Name="PvBarTop"    Fill="Black" Height="0" VerticalAlignment="Top"    HorizontalAlignment="Stretch"/>
                        <Rectangle x:Name="PvBarBottom" Fill="Black" Height="0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"/>
                        <Rectangle x:Name="PvBarLeft"   Fill="Black" Width="0"  HorizontalAlignment="Left"  VerticalAlignment="Stretch"/>
                        <Rectangle x:Name="PvBarRight"  Fill="Black" Width="0"  HorizontalAlignment="Right" VerticalAlignment="Stretch"/>

                        <!-- Shown for every video item until clicked (the
                             in-app preview no longer auto-plays - see
                             Update-PreviewDisplay) AND, reusing the same
                             elements, as a fallback if playback is then
                             attempted and fails (MediaFailed). Background is
                             Transparent (not the XAML default of null) so the
                             whole area - not just the icon/text - is
                             clickable; see PnlVideoBadge's Add_MouseLeftButtonDown
                             handler in Wall-E.ps1. -->
                        <Border x:Name="PnlVideoBadge" Visibility="Collapsed" Background="Transparent" Cursor="Hand">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#1E1E24" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#D8A94A" BlurRadius="16" ShadowDepth="0" Opacity="0.5"/>
                                    </Border.Effect>
                                    <TextBlock Text="▶" FontSize="24" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Border>
                                <TextBlock x:Name="TxtVideoBadgeTitle" Text="PLAYING AS VIDEO WALLPAPER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
                                <TextBlock x:Name="TxtVideoBadgeSub" Text="Check your desktop - couldn't load an in-app preview for this file" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="240"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Overlay toolbar: preview fit mode (images) / aspect ratio
                     (videos) + full-screen button. CmbPreviewStretch's items
                     are swapped in code-behind depending on whether the
                     current item is an image or a video - see
                     Set-PreviewComboMode in Wall-E.ps1. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                    <ComboBox x:Name="CmbPreviewStretch" Width="92" Margin="0,0,6,0" ToolTip="Preview fit mode">
                        <ComboBoxItem Content="Fit" Tag="Uniform" IsSelected="True"/>
                        <ComboBoxItem Content="Fill" Tag="UniformToFill"/>
                        <ComboBoxItem Content="Stretch" Tag="Fill"/>
                        <ComboBoxItem Content="Center" Tag="None"/>
                    </ComboBox>
                    <Button x:Name="BtnFullScreen" Content="⛶" Style="{StaticResource NavButton}" Width="36" Padding="0" ToolTip="Full screen preview"/>
                </StackPanel>

                <!-- Play/Pause + Stop controls for the in-app video preview.
                     The whole panel is collapsed by default (matches
                     PnlVideoBadge's "click to play" state) and only shown
                     once VidPreview is actually playing - see PnlVideoBadge's
                     click handler and BtnStopPreview's own click handler in
                     Wall-E.ps1, both of which keep PreviewControlsPanel in
                     sync with VidPreview.Visibility (both buttons stay
                     Visible themselves - it's the panel that's toggled, so
                     there's one visibility flag instead of two to keep in
                     sync). BtnPlayPause toggles $script:VidPreviewPaused;
                     BtnStopPreview ends the in-app preview entirely (and its
                     MediaElement/Media Foundation resources - see
                     Invoke-MemoryTrim) without navigating away from the item. -->
                <StackPanel x:Name="PreviewControlsPanel" Orientation="Horizontal" Visibility="Collapsed"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0">
                    <Button x:Name="BtnPlayPause" Content="⏸" Style="{StaticResource NavButton}"
                            Width="30" Height="30" Padding="0" FontSize="13" Margin="0,0,6,0" ToolTip="Pause preview"/>
                    <Button x:Name="BtnStopPreview" Content="✕" Style="{StaticResource NavButton}"
                            Width="30" Height="30" Padding="0" FontSize="13" ToolTip="Stop in-app preview"/>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Everything below the preview: sized to its content and
             scrollable, so it never eats into the preview's space and
             still works if the window gets short. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,10,0,0">
        <StackPanel>

            <!-- Folder / image info + Loop Folder toggle -->
            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtFolderName" Text="No folder loaded" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtImageInfo" Text="—" FontSize="12" Foreground="{StaticResource MutedTextBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <!-- Toggle: when on, Slideshow (and Shuffle) wrap around
                     inside the CURRENT folder instead of rolling into the
                     next one once the last image is reached - see
                     Go-NextImage/Go-PrevImage/Go-RandomImage in
                     Wall-E.ps1. Styled with PrimaryButton (accent/yellow -
                     same color as TxtFolderName above) while on, plain
                     NavButton while off - see Update-LoopFolderButtonVisual. -->
                <Button x:Name="BtnLoopFolder" Grid.Column="1" Content="⟲ Loop Folder" Style="{StaticResource NavButton}"
                        VerticalAlignment="Top" Padding="10,6" FontSize="11"
                        ToolTip="When Slideshow reaches the end of this folder, loop back to its start instead of moving to the next folder"/>
            </Grid>

            <!-- Video trimmer: drag the two handles (or click anywhere on
                 the track) to pick the in/out points a video should play.
                 Placed here (below the preview, not overlaid on top of it)
                 so it never obscures the video itself - only shown for
                 video items once the in-app preview knows the real
                 duration (see VidPreview's MediaOpened handler and
                 Show-MarkerBar in Wall-E.ps1). Dragging is handled via
                 ThumbMarkStart/ThumbMarkEnd's DragDelta events; clicking
                 the empty track via MarkerTrack's own MouseLeftButtonDown
                 just seeks (no marker change). The accent-colored
                 MarkerRangeFill is repositioned in code-behind whenever
                 the track resizes, a handle moves, or playback position
                 changes (Set-VideoMarker persists the result per-file -
                 see VideoMarkers.ps1). PnlMarkerStartRow/PnlMarkerEndRow
                 give precise alternatives to dragging - numeric entry,
                 "use the current position", and +/-1s / +/-0.1s nudges. -->
            <Border x:Name="MarkerBar" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush2}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                <StackPanel>
                    <Grid x:Name="MarkerTrackRow" Height="20">
                        <Border Height="4" Background="{StaticResource BorderBrush2}" CornerRadius="2" VerticalAlignment="Center"/>
                        <Canvas x:Name="MarkerTrack" Background="Transparent" Height="20">
                            <Rectangle x:Name="MarkerRangeFill" Height="4" Canvas.Top="8" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentBrush}"/>
                            <!-- Tag carries this handle's current fill color -
                                 both start at the base accent/yellow; the
                                 one you last clicked or dragged (the one
                                 nudge/Set-Here below currently act on - see
                                 Update-MarkerSelectionVisual) turns red, the
                                 other stays yellow. Tag is repurposed here
                                 rather than adding a real dependency
                                 property, since it's already free to set
                                 per-instance from code and the template
                                 just needs somewhere to bind Fill from. -->
                            <Thumb x:Name="ThumbMarkStart" Width="14" Height="14" Canvas.Top="3" Cursor="SizeWE" ToolTip="Drag to set start point" Tag="{StaticResource AccentBrush}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{TemplateBinding Tag}" Stroke="White" StrokeThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Thumb x:Name="ThumbMarkEnd" Width="14" Height="14" Canvas.Top="3" Cursor="SizeWE" ToolTip="Drag to set end point" Tag="{StaticResource AccentBrush}">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Ellipse Fill="{TemplateBinding Tag}" Stroke="White" StrokeThickness="1.5"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Canvas>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="TxtMarkRange" Text="Full video" FontSize="10" Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnPreviewMarker" Content="▶ Preview section" Style="{StaticResource NavButton}"
                                FontSize="10" Padding="8,3" ToolTip="Play just the marked section on loop"/>
                        <Button Grid.Column="2" x:Name="BtnClearMarker" Content="Reset to full video" Style="{StaticResource NavButton}"
                                FontSize="10" Padding="8,3" Margin="8,0,0,0" ToolTip="Clear the marked section - play the whole video"/>
                    </Grid>

                    <!-- Start point: numeric entry (type a time, press Enter),
                         "Set Here" (uses VidPreview's current position - see
                         click-to-seek on MarkerTrack and Play/Pause above,
                         which are how you land on the frame you want first),
                         and +/-1s / +/-0.1s nudges for fine correction after
                         a drag. All funnel through Nudge-MarkerStart or set
                         $script:MarkerStartSeconds directly then call
                         Update-MarkerHandlePositions + Save-CurrentMarker -
                         same as dragging the handle itself. -->
                    <StackPanel x:Name="PnlMarkerStartRow" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Start" Width="32" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBox x:Name="TxtMarkStartInput" Width="52" Height="24" VerticalContentAlignment="Center" FontSize="11" Margin="4,0,0,0" ToolTip="Type a time (m:ss) and press Enter"/>
                    </StackPanel>

                    <!-- End point display - same as Start, mirrored. -->
                    <StackPanel x:Name="PnlMarkerEndRow" Orientation="Horizontal" Margin="0,6,0,0" VerticalAlignment="Center">
                        <TextBlock Text="End" Width="32" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBox x:Name="TxtMarkEndInput" Width="52" Height="24" VerticalContentAlignment="Center" FontSize="11" Margin="4,0,0,0" ToolTip="Type a time (m:ss) and press Enter"/>
                    </StackPanel>

                    <!-- Shared editing controls - act on whichever handle
                         was last clicked/dragged (see
                         Update-MarkerSelectionVisual and each Thumb's
                         DragStarted in Wall-E.ps1), rather than duplicating
                         a full set of Set-Here/nudge buttons per side.
                         TxtMarkerSelectedLabel names which one that is and
                         is colored to match that handle's highlight. -->
                    <StackPanel x:Name="PnlMarkerEditRow" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtMarkerSelectedLabel" Text="Editing: START" Width="80" VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                        <Button x:Name="BtnSetSelectedHere" Content="Set Here" Style="{StaticResource NavButton}" FontSize="10" Padding="6,3" Margin="6,0,0,0" ToolTip="Use the current preview position as the selected point"/>
                        <Button x:Name="BtnSelMinus1" Content="−1s" Style="{StaticResource NavButton}" FontSize="10" Padding="6,3" Margin="6,0,0,0"/>
                        <Button x:Name="BtnSelMinus01" Content="−.1s" Style="{StaticResource NavButton}" FontSize="10" Padding="6,3" Margin="4,0,0,0"/>
                        <Button x:Name="BtnSelPlus01" Content="+.1s" Style="{StaticResource NavButton}" FontSize="10" Padding="6,3" Margin="4,0,0,0"/>
                        <Button x:Name="BtnSelPlus1" Content="+1s" Style="{StaticResource NavButton}" FontSize="10" Padding="6,3" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Directional controls (mirrors arrow keys) -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="BtnUp" Grid.Row="0" Grid.Column="1" Content="▲ Next Folder" Style="{StaticResource NavButton}" Margin="3"/>

                <Button x:Name="BtnLeft" Grid.Row="1" Grid.Column="0" Content="◀ Prev Wallpaper" Style="{StaticResource NavButton}" Margin="3"/>
                <Button x:Name="BtnDown" Grid.Row="1" Grid.Column="1" Content="▼ Prev Folder" Style="{StaticResource NavButton}" Margin="3"/>
                <Button x:Name="BtnRight" Grid.Row="1" Grid.Column="2" Content="Next Wallpaper ▶" Style="{StaticResource NavButton}" Margin="3"/>
            </Grid>

            <!-- Root folder -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="LIBRARY FOLDER" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtRootPath" Grid.Column="0" IsReadOnly="True" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource BorderBrush2}" Padding="6" VerticalContentAlignment="Center"/>
                    <Button x:Name="BtnBrowse" Grid.Column="1" Content="Browse…" Style="{StaticResource NavButton}" Margin="6,0,0,0" Padding="10,6"/>
                </Grid>
            </StackPanel>

            <!-- Style -->
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="WALLPAPER STYLE (IMAGES)" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <ComboBox x:Name="CmbStyle" Margin="0,4,6,0" ToolTip="Applies to still-image wallpapers only. Videos use the Aspect Ratio combo below.">
                        <!-- Tag = the WPF Stretch value that visually
                             approximates this Windows wallpaper style, used
                             to drive the overlay preview combo (see
                             Set-PreviewComboMode) so it never drifts out of
                             sync with the real setting again. Span (spread
                             across all monitors) has no exact single-panel
                             equivalent - UniformToFill is the closest visual
                             approximation for previewing it here. -->
                        <ComboBoxItem Content="Fill"    Tag="UniformToFill"/>
                        <ComboBoxItem Content="Fit"     Tag="Uniform"/>
                        <ComboBoxItem Content="Stretch" Tag="Fill"/>
                        <ComboBoxItem Content="Center"  Tag="None"/>
                        <ComboBoxItem Content="Span"    Tag="UniformToFill"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                    <CheckBox x:Name="ChkHotkeys" Content="Hotkeys enabled (global)" Foreground="{StaticResource TextBrush}" Margin="6,0,0,8" IsChecked="True"
                              ToolTip="Global arrows (navigate) + S (slideshow) + P (quick play) + A (aspect ratio) control Wall-E system-wide. Press Ctrl+Alt+W anywhere to toggle the whole group on/off without reopening the app."/>
                    <TextBlock Text="Toggle anywhere: Ctrl+Alt+W" FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>

            <!-- Video wallpaper (plays .mp4/.wmv/.avi/.mov/.mkv found in a
                 folder just like images; auto-advances to the next item
                 in the folder when the video finishes) -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="VIDEO WALLPAPER" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkVideoAudio" Content="Play video audio (muted by default)" Foreground="{StaticResource TextBrush}"/>
                </Grid>
                <TextBlock Text="ASPECT RATIO" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0"/>
                <ComboBox x:Name="CmbVideoAspect" Margin="0,4,6,0" HorizontalAlignment="Left" Width="140"
                          ToolTip="Forces the video's display aspect ratio, like VLC's Aspect Ratio menu. 'Default' plays at full-screen cover with no forced shape.">
                    <ComboBoxItem Content="Default" Tag="0" IsSelected="True"/>
                    <ComboBoxItem Content="4:3" Tag="1.3333333333333333"/>
                    <ComboBoxItem Content="16:9" Tag="1.7777777777777777"/>
                    <ComboBoxItem Content="16:10" Tag="1.6"/>
                    <ComboBoxItem Content="21:9 (2.21:1)" Tag="2.21"/>
                </ComboBox>
                <TextBlock Text="Drop video files into a snapshot folder alongside images - Wall-E plays them embedded behind your desktop icons, then automatically moves on to the next item when they finish." FontSize="10" Foreground="{StaticResource MutedTextBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Slideshow settings (mirrors Windows' own slideshow options) -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="SLIDESHOW" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Change picture every" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbInterval" Grid.Column="1" Width="150">
                        <ComboBoxItem Content="5 seconds" Tag="5"/>
                        <ComboBoxItem Content="10 seconds" Tag="10"/>
                        <ComboBoxItem Content="30 seconds" Tag="30" IsSelected="True"/>
                        <ComboBoxItem Content="1 minute" Tag="60"/>
                        <ComboBoxItem Content="10 minutes" Tag="600"/>
                        <ComboBoxItem Content="30 minutes" Tag="1800"/>
                        <ComboBoxItem Content="1 hour" Tag="3600"/>
                        <ComboBoxItem Content="6 hours" Tag="21600"/>
                        <ComboBoxItem Content="1 day" Tag="86400"/>
                    </ComboBox>
                </Grid>
                <CheckBox x:Name="ChkShuffle" Content="Shuffle the picture order" Foreground="{StaticResource TextBrush}" Margin="0,10,0,0"/>
            </StackPanel>

            <!-- Quick play (stop-motion style flip through images at a fixed pace) -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="QUICK PLAY" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="RbSpeedLow" Grid.Column="0" Content="Low-paced" GroupName="QuickPlaySpeed" Style="{StaticResource SpeedOption}" Margin="0,0,3,0"/>
                    <RadioButton x:Name="RbSpeedMedium" Grid.Column="1" Content="Medium-paced" GroupName="QuickPlaySpeed" Style="{StaticResource SpeedOption}" Margin="3,0" IsChecked="True"/>
                    <RadioButton x:Name="RbSpeedHigh" Grid.Column="2" Content="High-paced" GroupName="QuickPlaySpeed" Style="{StaticResource SpeedOption}" Margin="3,0,0,0"/>
                </Grid>
                <Button x:Name="BtnQuickPlay" Content="▶ Play (P)" Style="{StaticResource NavButton}" Margin="0,8,0,0" Padding="10,8"/>
            </StackPanel>

            <!-- Slideshow / Refresh -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BtnPlay" Grid.Column="0" Content="▶ Start Slideshow (S)" Style="{StaticResource NavButton}" Margin="0,0,6,0" Padding="10,8"/>
                <Button x:Name="BtnRefresh" Grid.Column="1" Content="Rescan Library" Style="{StaticResource PrimaryButton}" Padding="10,8"/>
            </Grid>

            <!-- Status bar -->
            <Border BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,8,0,0">
                <TextBlock x:Name="TxtStatus" Text="Ready." FontSize="11" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            </Border>

        </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
